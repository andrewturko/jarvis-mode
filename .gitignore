# Runtime data directory (personal activity, state, learned patterns)
data/

# Logs (keep directory via .gitkeep)
logs/*
!logs/.gitkeep

# User-specific config (generated/configured per home)
config/config.json
config/capabilities.json
config/voice-config.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Testing
.coverage
.pytest_cache/
htmlcov/

# IDE/Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Claude Code sessions
.claude/

# Keep example files for shareability
!config/*.example.json
